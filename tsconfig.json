{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "rootDir": "src",
    "outDir": "app/js",
    "skipLibCheck": true,
    "removeComments": false
  },
  "include": ["src"]
}
